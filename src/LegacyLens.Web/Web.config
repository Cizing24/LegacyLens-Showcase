<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="LegacyLens" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=LegacyLens;Integrated Security=True;Connect Timeout=30" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="zh-TW" uiCulture="zh-TW" />
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="1024" executionTimeout="60" enableVersionHeader="false" />
    <authentication mode="Forms"><forms loginUrl="~/Login.aspx" timeout="20" slidingExpiration="false" protection="All" cookieless="UseCookies" cookieSameSite="Strict" /></authentication>
    <httpCookies httpOnlyCookies="true" sameSite="Strict" />
    <sessionState timeout="20" cookieless="UseCookies" cookieSameSite="Strict" />
    <pages validateRequest="true" enableEventValidation="true" enableViewStateMac="true" viewStateEncryptionMode="Always" controlRenderingCompatibilityVersion="4.0" />
    <customErrors mode="On" />
    <trace enabled="false" />
  </system.web>
  <system.webServer>
    <defaultDocument><files><clear /><add value="Cases.aspx" /></files></defaultDocument>
    <httpErrors existingResponse="PassThrough" />
    <security><requestFiltering><requestLimits maxAllowedContentLength="1048576" /><hiddenSegments><add segment="obj" /></hiddenSegments></requestFiltering></security>
  </system.webServer>
</configuration>
