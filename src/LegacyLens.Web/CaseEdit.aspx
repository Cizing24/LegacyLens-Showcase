<%@ Page Language="C#" MasterPageFile="~/Site.master" CodeBehind="CaseEdit.aspx.cs" Inherits="LegacyLens.Web.CaseEditPage" %>
<asp:Content ContentPlaceHolderID="Main" runat="server">
<a class="back-link" href="Cases.aspx">返回案件總覽</a><div class="page-heading"><div><h1><asp:Literal ID="Heading" runat="server" Text="建立案件" /></h1><p>儲存案件內容與處理狀態，系統會同步保留操作紀錄。</p></div><span class="record-id"><%: CaseId == 0 ? "新案件" : "LL-" + CaseId.ToString("D6") %></span></div>
<asp:Label ID="Message" runat="server" CssClass="message" role="alert" />
<div class="edit-layout"><section class="panel form-panel"><h2>案件資料</h2><asp:Label runat="server" AssociatedControlID="CaseTitle" Text="案件主旨（必填）" /><asp:TextBox ID="CaseTitle" runat="server" MaxLength="160" />
<div class="form-row"><div><asp:Label runat="server" AssociatedControlID="CustomerId" Text="客戶（必填）" /><asp:DropDownList ID="CustomerId" runat="server" /></div><div><asp:Label runat="server" AssociatedControlID="AssignedTo" Text="承辦人（必填）" /><asp:DropDownList ID="AssignedTo" runat="server" /></div></div>
<div class="form-row"><div><asp:Label runat="server" AssociatedControlID="Status" Text="處理狀態" /><asp:DropDownList ID="Status" runat="server"><asp:ListItem Value="Open">待處理</asp:ListItem><asp:ListItem Value="InProgress">處理中</asp:ListItem><asp:ListItem Value="Closed">已結案</asp:ListItem></asp:DropDownList></div><div><asp:Label runat="server" AssociatedControlID="Category" Text="分類提示（Postback）" /><asp:DropDownList ID="Category" runat="server" data-postback="true" OnSelectedIndexChanged="Category_Changed"><asp:ListItem>一般服務</asp:ListItem><asp:ListItem>技術維護</asp:ListItem><asp:ListItem>資料查詢</asp:ListItem></asp:DropDownList></div></div>
<asp:Label ID="CategoryHint" runat="server" CssClass="muted" /><asp:Label runat="server" AssociatedControlID="Description" Text="案件說明" /><asp:TextBox ID="Description" runat="server" TextMode="MultiLine" Rows="6" MaxLength="2000" />
<div class="form-actions"><asp:Button ID="Save" runat="server" Text="儲存案件" CssClass="button" OnClick="Save_Click" /><a href="Cases.aspx" class="secondary">取消</a></div></section>
<aside class="panel details-panel"><h2>操作原則</h2><p>承辦人可更新自己的案件，主管可進行指派及重新開啟。</p><hr /><h3>編輯保護</h3><p>資料若已被其他人更新，系統會請你重新載入，避免覆寫最新內容。</p><h3>歷程保留</h3><p>儲存、狀態更新與指派都會連同操作者與追蹤編號一起記錄。</p></aside></div>
<asp:Panel ID="TransferPanel" runat="server" CssClass="panel form-panel history-panel"><h2>案件轉派</h2><p class="muted">限主管操作。已結案案件須先重新開啟；轉派會保留前後承辦人與原因。</p><div class="form-row"><div><asp:Label runat="server" AssociatedControlID="TransferTarget" Text="新承辦人" /><asp:DropDownList ID="TransferTarget" runat="server" /></div><div><asp:Label runat="server" AssociatedControlID="TransferReason" Text="轉派原因（5～500 字）" /><asp:TextBox ID="TransferReason" runat="server" MaxLength="500" /></div></div><asp:Button ID="Transfer" runat="server" Text="確認轉派" CssClass="button" OnClick="Transfer_Click" /></asp:Panel>
<section class="panel history-panel"><h2>處理歷程</h2><div class="table-wrap"><asp:GridView ID="HistoryGrid" runat="server" AutoGenerateColumns="false" GridLines="None" CssClass="data-table" EmptyDataText="儲存案件後，處理歷程會顯示在這裡。"><Columns><asp:BoundField HeaderText="操作" DataField="Action" /><asp:BoundField HeaderText="先前狀態" DataField="OldStatus" /><asp:BoundField HeaderText="更新狀態" DataField="NewStatus" /><asp:BoundField HeaderText="操作者" DataField="Actor" /><asp:BoundField HeaderText="承辦人" DataField="Assignee" /><asp:BoundField HeaderText="原因" DataField="Reason" /><asp:BoundField HeaderText="時間（UTC）" DataField="OccurredAt" DataFormatString="{0:yyyy-MM-dd HH:mm:ss}" /></Columns></asp:GridView></div></section>
</asp:Content>
