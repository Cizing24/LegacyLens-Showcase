<%@ Page Language="C#" MasterPageFile="~/Site.master" CodeBehind="Customers.aspx.cs" Inherits="LegacyLens.Web.CustomersPage" %>
<asp:Content ContentPlaceHolderID="Main" runat="server"><div class="page-heading"><div><h1>客戶資料</h1><p>維護服務對象與基本分類。展示資料均為合成客戶。</p></div></div><asp:Label ID="Message" runat="server" CssClass="message" role="alert" />
<div class="edit-layout"><section class="panel"><div class="filters"><div><asp:Label runat="server" AssociatedControlID="Keyword" Text="客戶名稱" /><asp:TextBox ID="Keyword" runat="server" MaxLength="120" /></div><div><asp:Label runat="server" AssociatedControlID="FilterIndustry" Text="產業分類" /><asp:TextBox ID="FilterIndustry" runat="server" MaxLength="80" /></div><asp:Button runat="server" Text="查詢客戶" OnClick="Search_Click" CssClass="button" /></div><div class="table-wrap"><asp:GridView ID="CustomersGrid" runat="server" AutoGenerateColumns="false" GridLines="None" CssClass="data-table" EmptyDataText="找不到符合條件的客戶。"><Columns><asp:HyperLinkField HeaderText="客戶編號" DataTextField="Id" DataNavigateUrlFields="Id" DataNavigateUrlFormatString="Customers.aspx?id={0}" /><asp:BoundField HeaderText="名稱" DataField="Name" /><asp:BoundField HeaderText="產業" DataField="Industry" /></Columns></asp:GridView></div><p class="data-note">最多顯示 100 筆，請以名稱及產業縮小查詢。</p></section>
<section class="panel form-panel"><h2><asp:Literal ID="FormHeading" runat="server" Text="建立客戶" /></h2><asp:Label runat="server" AssociatedControlID="CustomerName" Text="客戶名稱（必填）" /><asp:TextBox ID="CustomerName" runat="server" MaxLength="120" /><asp:Label runat="server" AssociatedControlID="Industry" Text="產業（必填）" /><asp:TextBox ID="Industry" runat="server" MaxLength="80" /><div class="form-actions"><asp:Button ID="Save" runat="server" Text="儲存客戶" OnClick="Save_Click" CssClass="button" /><a href="Customers.aspx" class="secondary">新增另一位</a></div><p class="muted">客戶資料異動需要主管權限。</p></section></div></asp:Content>
