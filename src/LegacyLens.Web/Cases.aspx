<%@ Page Language="C#" MasterPageFile="~/Site.master" CodeBehind="Cases.aspx.cs" Inherits="LegacyLens.Web.CasesPage" %>
<asp:Content ContentPlaceHolderID="Main" runat="server">
<div class="page-heading"><div><h1>案件總覽</h1><p>檢索服務案件，掌握承辦進度與處理紀錄。</p></div><a class="button" href="CaseEdit.aspx">建立案件</a></div>
<div class="summary"><asp:Repeater ID="Stats" runat="server"><ItemTemplate><div><span><%# StatusLabel((string)Eval("Status")) %></span><strong><%# Eval("Total","{0:N0}") %></strong></div></ItemTemplate></asp:Repeater></div>
<section class="panel"><div class="filters"><div><asp:Label runat="server" AssociatedControlID="SearchTitle" Text="案件主旨" /><asp:TextBox ID="SearchTitle" runat="server" MaxLength="160" placeholder="輸入關鍵字" /></div><div><asp:Label runat="server" AssociatedControlID="Status" Text="狀態" /><asp:DropDownList ID="Status" runat="server"><asp:ListItem Value="">全部狀態</asp:ListItem><asp:ListItem Value="Open">待處理</asp:ListItem><asp:ListItem Value="InProgress">處理中</asp:ListItem><asp:ListItem Value="Closed">已結案</asp:ListItem></asp:DropDownList></div><asp:Button ID="Search" runat="server" Text="查詢案件" CssClass="button" OnClick="Search_Click" /></div>
<asp:Label ID="Message" runat="server" CssClass="message" role="alert" />
<div class="table-wrap"><asp:GridView ID="CasesGrid" runat="server" AutoGenerateColumns="false" CssClass="data-table" GridLines="None" EmptyDataText="找不到符合條件的案件，請調整關鍵字或狀態。"><Columns><asp:HyperLinkField HeaderText="案件編號" DataTextField="Id" DataTextFormatString="LL-{0:D6}" DataNavigateUrlFields="Id" DataNavigateUrlFormatString="CaseEdit.aspx?id={0}" /><asp:BoundField HeaderText="案件主旨" DataField="Title" /><asp:BoundField HeaderText="客戶" DataField="Customer" /><asp:TemplateField HeaderText="狀態"><ItemTemplate><span class="status"><%# StatusLabel((string)Eval("Status")) %></span></ItemTemplate></asp:TemplateField><asp:BoundField HeaderText="承辦人" DataField="Assignee" /><asp:BoundField HeaderText="建立日期" DataField="CreatedAt" DataFormatString="{0:yyyy-MM-dd}" /></Columns></asp:GridView></div>
<div class="pagination"><asp:Label ID="PageInfo" runat="server" /><div><asp:Button ID="Previous" runat="server" Text="上一頁" OnClick="Previous_Click" CssClass="secondary" /><asp:Button ID="Next" runat="server" Text="下一頁" OnClick="Next_Click" CssClass="secondary" /></div></div></section>
<p class="data-note">資料說明：NYC 311 公共服務請求供工程測試使用；客戶與承辦人欄位為合成資料。</p>
</asp:Content>
